# GEMINI_API_KEY: Primary provider for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional automatic fallback providers (used automatically if Gemini quota/credits run out).
# Configure any subset of these keys on your server/hosting (e.g. Vercel Environment Variables).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Optional custom failover priority (comma-separated: gemini,openai,anthropic,openrouter)
AI_PROVIDER_ORDER="gemini,openai,anthropic,openrouter"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Contact form delivery (configure in Vercel Environment Variables once your n8n webhook is ready):
# Primary: n8n webhook URL (e.g. https://n8n.mykh-automation.com/webhook/portfolio-contact)
N8N_CONTACT_WEBHOOK_URL=""
# Optional fallback: direct Telegram Bot alert if N8N_CONTACT_WEBHOOK_URL is not set
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
